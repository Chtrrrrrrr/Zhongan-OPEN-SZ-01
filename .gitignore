# 文档类静态资源白名单（README/文档配图放在 assets/，允许入库）
!assets/**/*.png
!assets/**/*.jpg
!assets/**/*.jpeg
!assets/**/*.gif
!assets/**/*.webp

# ---------- 模型权重（不入库；如需共享请使用 Git LFS 或外部分发） ----------
# 推荐：git lfs track "*.pt" "*.pth" "*.onnx" "*.bin" "*.safetensors"
models/*
!models/.gitkeep
*.pt
*.pth
*.ckpt
*.onnx
*.bin
*.safetensors
*.h5
*.pkl
*.joblib

# ---------- 运行产物 ----------
reports/*
!reports/.gitkeep
!reports/metrics.json
!reports/feature_ablation.json
!reports/fusion_ablation.json
!reports/smoke_test.json
!reports/error_analysis.csv
!reports/npr_ablation.json
