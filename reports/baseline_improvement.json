 "fidelity_findings": [
  {
   "id": "F1",
   "severity": "high",
   "finding": "The published headline 0.9594 ('95.94% out-of-fold') is NOT reproducible from the committed repo/models/ artefacts. It comes from repo/reports/fusion_tuning_reals.json::best_by_official_accuracy, which needs the external corpus (1040 real + 521 fake) and models/external_corpus/ - both absent - and is the best-of-9 weight-set selection.",
   "implication": "downstream tasks must use P-A (0.9748 @ fp_budget=2) as the baseline, and must not treat 0.9594 as the number to beat without re-deriving it"
  },
  {
   "id": "F2",
   "severity": "high",
   "finding": "work/improvement-plan.md states that 057/058 'already sit in review (confidence 0.055 / 0.043)'. Those values come from work/acceptance_repo.json, whose heads are fit on all 119 samples. Out-of-fold, 057/058 are among the STRONGEST positives (pooled logits +8.473 and +3.548, the two largest real scores; bundle OOF probabilities 0.9997 / 0.9937) and are flagged suspect in 6/6 rounds.",
   "implication": "a decision-layer rule tuned to the in-sample scores would look perfect in-sample and fail out-of-fold. Any 057/058 gate must be pre-registered and validated on the frozen OOF scores; the baseline false positives are not marginal."
  },
  {
   "id": "F3",
   "severity": "medium",
   "finding": "The deployed threshold in repo/models/fusion.json (thr_high=0.826623 = sigmoid(1.561879)) is not the accuracy-optimal point of the fp_budget=2 region: any threshold in (-0.424307, 3.548064] yields exactly 2 false positives, and the chosen point costs accuracy (repo's own deployed-rule summary accuracy mean is 0.9258 vs 0.9748 at the bounded end of the same budget).",
   "implication": "threshold choice within the fp_budget=2 plateau must be pre-registered and reported, and must never be optimised on the 119"
  },
  {
   "id": "F4",
   "severity": "medium",
   "finding": "Review band 26/119 mixes two different causes: 14 pure model_disagreement, 7 pure uncertainty_band, 5 both. Only 7+5=12 are caused by the uncertainty band itself, so narrowing the band alone cannot remove more than ~12 of the 26.",
   "implication": "t4 must report the two causes separately; a band-only fix has a hard ceiling"
  },
  {
   "id": "F5",
   "severity": "medium",
   "finding": "Two fusion configurations coexist: repo/models/fusion.json (thr_low=0.0266, thr_high=0.826623, temps 1.66289/1.14902) and root models/fusion.json (thr_low=0.0364404, thr_high=0.674288, temps 1.70996/1.133203). Weights (0.6/0.25) and disagree_review (1.25) are identical.",
   "implication": "scripts/smoke_test.py defaulting to the stale root models/ silently evaluates a different operating point; t2 must unify the path and publish both hashes"
  },
  {
   "id": "F6",
   "severity": "low",
   "finding": "The working tree at claim time already carried drift: ' M scripts/smoke_test.py' and '?? scripts/models_path.py'. It predates this task and is not attributable to the baseline work; the baseline reads only committed JSON artefacts.",
   "implication": "the baseline is pinned to HEAD fd6ce90 plus the recorded artefact hashes"
  },
  {
   "id": "F7",
   "severity": "high",
   "finding": "repo/.gitignore:70 ignores 'reports/*' with a per-file whitelist. This deliverable lives at repo/reports/baseline_improvement.json and is therefore ignored by git: it exists on disk and the verify command passes, but it cannot be committed or diffed without an explicit whitelist line. This is the same mechanism that made models/fix_metrics.json disappear while 18 places cite it.",
   "implication": "a follow-up task must add '!reports/baseline_improvement.json' (and the other reports that constitute the reproducible evidence pack) to repo/.gitignore, then `git add -f` and commit them. Until then every downstream task must verify the file by sha256, not by git status."
  }
 ],
